# ---------------------------------------------------------------------------
# WebCraft — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for metadataBase, sitemap, robots, OG image URLs
# and JSON-LD @id values. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Lead capture -----------------------------------------------------------
# Transactional email provider for the contact form (https://resend.com).
RESEND_API_KEY=""
# Verified sender on your domain, e.g. "WebCraft <hello@webcraft.com>"
CONTACT_FROM_EMAIL=""
# Where new leads land.
CONTACT_TO_EMAIL=""

# --- Analytics (optional) ---------------------------------------------------
# Cookieless, GDPR-friendly analytics. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# --- Verification (optional) ------------------------------------------------
GOOGLE_SITE_VERIFICATION=""
